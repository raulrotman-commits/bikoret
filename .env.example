# --- חובה ---
DATABASE_URL=mysql://user:pass@host:3306/bikoret
JWT_SECRET=change-me-long-random-string
APP_URL=https://bikoret.rotmansafety.com

# --- בעלים / מנהל (פטור מתשלום, רואה את לוח הניהול) ---
OWNER_EMAIL=raulrotman@gmail.com

# --- אחסון תמונות (S3 תואם). בלי אלה התמונות נשמרות בדיסק המקומי (לפיתוח בלבד) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- מייל (Resend): איפוס סיסמה ---
RESEND_API_KEY=
EMAIL_FROM=רוטמן בטיחות <no-reply@rotmansafety.com>

# --- מנוי: ביקורת שטח כלולה במנוי רוטמן בטיחות ---
TRIAL_DAYS=14
# מסד הנתונים של האתר הראשי (קריאה בלבד, הטבלאות users ו-subscriptions). ב-Railway: ${{rotmansafety.DATABASE_URL}}
RS_DATABASE_URL=
# האתר הראשי ודף המנוי בו
RS_SITE_URL=https://www.rotman-safety.com
RS_SUBSCRIBE_PATH=/pricing
